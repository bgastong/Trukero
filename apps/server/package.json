{
  "name": "@trukero/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --port 3001",
    "dev:lan": "tsx watch src/index.ts --port 3001",
    "build": "tsup src/index.ts --format esm --target node22 --clean --no-external @trukero/core",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@trukero/core": "workspace:*",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
